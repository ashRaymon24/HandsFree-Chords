{
  "manifest_version": 3,
  "name": "HandsFree Chords",
  "version": "1.0",
  "description": "Scroll chord sheets hands-free using webcam head gestures.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {}
}